<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MusiChairs" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="colorPrimary">@color/DodgerBlue</item>
        <item name="colorPrimaryVariant">@color/NeonBlue</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/MiddleBlue</item>
        <!-- Background image. -->
        <item name="android:windowBackground">@drawable/img</item>

    </style>

    <style name="DarkLightText">
        <item name="android:textColor">@color/MiddleBlue</item>
        <item name="android:textColorHighlight">@color/MiddleBlue</item>
        <item name="android:textColorHint">@color/MiddleBlue</item>
        <item name="android:textColorLink">@color/MiddleBlue</item>
    </style>

    <style name="DarkLightButton" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/MiddleBlue</item>
    </style>

    <style name="CustomDrawable" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:indeterminateOnly">false</item>
        <item name="android:progressDrawable">@drawable/circle_light</item>
        <item name="android:indeterminateDrawable">@drawable/circle_light</item>
    </style>

    <style name="CustomEditText">
        <item name="android:background">@drawable/edittext</item>
        <item name="android:textColor">@color/MiddleBlue</item>
        <item name="android:textColorHighlight">@color/MiddleBlue</item>
        <item name="android:textColorHint">@color/MiddleBlue</item>
        <item name="android:textColorLink">@color/MiddleBlue</item>
    </style>

    <style name="CustomEditText1" parent="CustomEditText">
        <item name="android:drawableLeft">@drawable/baseline_group_24</item>
    </style>

    <style name="CustomEditText2" parent="CustomEditText">
        <item name="android:drawableLeft">@drawable/baseline_remove_circle_outline_24</item>
    </style>

    <style name="CustomEditText3" parent="CustomEditText">
        <item name="android:drawableLeft">@drawable/baseline_add_circle_outline_24</item>
    </style>

    <style name="Theme.MusiChairs" parent="Base.Theme.MusiChairs" />
</resources>